# Required
ANTHROPIC_API_KEY=your_key_here

# Upstash Redis (REST). Without it, counters are per-process and reset on restart.
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# CORS: set to your frontend origin(s) in production, comma separated. No wildcard.
ALLOWED_ORIGINS=http://localhost:5173

# Abuse / cost controls
RATE_LIMIT_PER_DAY=5
DAILY_BUDGET_USD=5
# Reverse proxies in front of the app that append to X-Forwarded-For (Railway: 2, verified in production: edge proxy + one more hop). 0 = ignore the header.
TRUSTED_PROXY_HOPS=2

# /stats is disabled (404) unless this is set. Sent in the X-Stats-Secret header. Use a long random value.
STATS_SECRET=

# Optional
MODEL=claude-haiku-4-5-20251001
SENTRY_DSN=

# Opt-in share links. Sharing is disabled unless this is set (and Redis is configured).
# Generate with: openssl rand -hex 32
SHARE_SIGNING_SECRET=
SHARE_TTL_DAYS=30
SHARES_PER_DAY=10
REPORT_HIDE_THRESHOLD=3
